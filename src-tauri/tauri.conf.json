{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chapter",
  "version": "1.4.0",
  "identifier": "studio.xiaofang.chapter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1440",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Chapter",
        "width": 1360,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": true,
        "backgroundColor": "#faf5ec",
        "dragDropEnabled": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; font-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "小方工作室",
    "copyright": "小方工作室 · MIT License",
    "category": "Productivity",
    "shortDescription": "全中文、免费开源的长篇小说写作工作台",
    "longDescription": "Chapter 是小方工作室自研的全中文、永久免费开源（MIT）的长篇小说写作工作台：书架、卷章场景三级目录、正文编辑、字数目标、专注模式、大纲卡片、人物设定与 EPUB 导出。零账号、零联网、不上传任何文字。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": null
    },
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}

